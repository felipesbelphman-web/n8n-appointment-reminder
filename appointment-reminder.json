                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        432,
        96
      ],
      "id": "1cc6d321-416d-4adf-9072-ce98804b0a8d",
      "name": "Filter Pending Reminders"
    },
    {
      "parameters": {
        "toRecipients": "={{ $json.email }}",
        "subject": "Reminder: your appointment is tomorrow",
        "bodyContent": "={{ 'Hi ' + $json.name + ',\\n\\nThis is a friendly reminder about your appointment tomorrow.\\n\\nService: ' + $json.service + '\\nDate: ' + $json.appointment_date + '\\nTime: ' + $json.appointment_time + '\\n\\nIf you need to reschedule, please reply to this email.\\n\\nSee you soon!' }}",
