              "id": "d72b502f-ee7e-48f8-9453-3e7a641b16c1",
              "leftValue": "={{ $json.appointment_date }}",
              "rightValue": "={{ $now.setZone('Europe/Dublin').plus({ days: 1 }).toFormat('yyyy-MM-dd') }}",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            },
            {
              "id": "7adff8d6-5cf2-4e7e-8793-37a46d5c3b1d",
              "leftValue": "={{ $json.reminder_sent }}",
              "rightValue": "NO",
              "operator": {
